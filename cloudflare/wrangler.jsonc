{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neon-sync-edge-gateway",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-22",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "NEON_SYNC_ORIGIN": "https://api.neonsync.example.com"
  }
}
