# Hardened Safe Egress Proxy (DNS resolution + global unicast IP verification + direct IP dial)
FROM python:3.13-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir .

RUN groupadd -g 10001 neonsync \
    && useradd -u 10001 -g 10001 -s /usr/sbin/nologin -M neonsync

USER 10001:10001
EXPOSE 3128

CMD ["neon-sync-proxy", "--host", "0.0.0.0", "--port", "3128"]
