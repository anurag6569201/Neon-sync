# Neon Sync Local & Production Environment Configuration
# Copy this file to .env and fill in any optional storage credentials.

NEON_SYNC_ENVIRONMENT=development
NEON_SYNC_API_HOST=127.0.0.1
NEON_SYNC_API_PORT=8000

# Persistent Job Database (SQLite WAL)
NEON_SYNC_JOB_DB_PATH=./data/jobs.sqlite3

# Keep empty for links that work on the current app domain, including HTTPS.
NEON_SYNC_ARTIFACT_BASE_URL=
NEON_SYNC_MAX_PENDING_JOBS=100
NEON_SYNC_MAX_CONCURRENT_DOWNLOADS=3
# Metadata browsing pages are independent of the per-download playlist limit.
NEON_SYNC_PLAYLIST_PROBE_PAGE_SIZE=50

# Optional Cloudflare Cloud Stack (R2 Artifact Storage & Turnstile Bot Shield)
NEON_SYNC_CF_R2_BUCKET=
NEON_SYNC_CF_R2_ACCESS_KEY_ID=
NEON_SYNC_CF_R2_SECRET_ACCESS_KEY=
NEON_SYNC_CF_TURNSTILE_SITE_KEY=
NEON_SYNC_CF_TURNSTILE_SECRET=
NEON_SYNC_CF_TURNSTILE_HOSTNAMES=localhost,127.0.0.1
