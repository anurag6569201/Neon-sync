# Neon Sync Local & Production Environment Configuration
# Copy this file to .env and fill in your credentials.

NEON_SYNC_ENVIRONMENT=development
NEON_SYNC_API_HOST=127.0.0.1
NEON_SYNC_API_PORT=8000

# Databases (SQLite WAL)
NEON_SYNC_JOB_DB_PATH=./data/jobs.sqlite3
NEON_SYNC_AUTH_DB_PATH=./data/auth.sqlite3

# Google Sign-In (OAuth 2.0 + PKCE)
# Create OAuth 2.0 Web Client credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://127.0.0.1:8000/v1/auth/google/callback
NEON_SYNC_GOOGLE_CLIENT_ID=
NEON_SYNC_GOOGLE_CLIENT_SECRET=
# Optional override if behind a reverse proxy / custom domain:
# NEON_SYNC_GOOGLE_REDIRECT_URI=https://yourdomain.com/v1/auth/google/callback
# NEON_SYNC_PUBLIC_BASE_URL=https://yourdomain.com

# Cloudflare Cloud Stack (R2 Artifact Storage & Turnstile Bot Shield)
NEON_SYNC_CF_R2_BUCKET=
NEON_SYNC_CF_R2_ACCESS_KEY_ID=
NEON_SYNC_CF_R2_SECRET_ACCESS_KEY=
NEON_SYNC_CF_TURNSTILE_SITE_KEY=
NEON_SYNC_CF_TURNSTILE_SECRET=
NEON_SYNC_CF_TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Session & Pro Access
NEON_SYNC_AUTH_SESSION_TTL_SECONDS=604800
NEON_SYNC_AUTH_COOKIE_SECURE=false
NEON_SYNC_PRO_API_KEYS=neon-pro-local
